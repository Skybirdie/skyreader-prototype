{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "skyreader-prototype",

  "main": "worker.js",

  "compatibility_date": "2026-09-18",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": false
  },

  "kv_namespaces": [
    {
      "binding": "MEDIA_KV",
      "id": "8a4f692a796b4aeab25262e831739781"
    }
  ],

  "images": {
    "binding": "IMAGES"
  }
}